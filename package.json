{
  "name": "@vim-villain/content",
  "version": "0.1.0",
  "description": "Deterministic lessons and challenge templates for vim-villain.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "ARCHITECTURE.md"
  ],
  "peerDependencies": {
    "@vim-villain/engine": ">=0.4.0 <0.5.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/semver": "^7.8.0",
    "@vim-villain/engine": "0.4.0",
    "semver": "^7.6.0",
    "typescript": "^5.9.3",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "scripts": {
    "codegen": "bun run scripts/codegen.ts",
    "validate": "bun run scripts/validate.ts",
    "typecheck": "bun run codegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "build": "bun run codegen && bun run scripts/build.ts",
    "test": "bun run build && bun test",
    "test:unit": "bun run codegen && bun test",
    "pack:check": "bun run build && bun run scripts/pack-check.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
